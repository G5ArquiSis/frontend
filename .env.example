# Copiar a .env y completar. NUNCA subir .env al repo.
# Vite solo expone al navegador las variables con prefijo VITE_; ninguna de estas es secreta.

# URL base de la API. En producción es https://api.melchort.me (API Gateway), que también acepta
# llamadas desde http://localhost:5173. Para un backend local, usar el proxy de Vite: sin gateway
# no hay CORS (ver docs/infraestructura.md).
VITE_API_URL=https://api.melchort.me

# Auth0: los entrega quien configura el tenant (rol D).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
